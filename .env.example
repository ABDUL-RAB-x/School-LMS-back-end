# ---------------------------------------------------------------------------
# Scholaris API — copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5051
# Website address(es) allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5273
# Public website address used in email links. Must be https:// in production.
APP_URL=http://localhost:5273

# --- Database -------------------------------------------------------------
# MongoDB Atlas SRV URI. The path segment is the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/school

# --- Sessions -------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Access token lifetime (httpOnly cookie), renewed silently with a rotating refresh token.
ACCESS_TOKEN_TTL=15m
# Refresh session length in days: without / with "Keep me signed in".
REFRESH_TTL_DAYS=1
REMEMBER_TTL_DAYS=30

# --- Sign-in protection -----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Email the user after every successful sign-in (time, device, IP).
LOGIN_ALERT_EMAIL=true

# --- OTP ------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# --- Google SMTP (Gmail) --------------------------------------------------
# Requires 2-Step Verification on the Gmail account, then an App Password:
#   https://myaccount.google.com/apppasswords
# Use the 16-character App Password below — never the real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.school@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Scholaris
MAIL_FROM_ADDRESS=your.school@gmail.com

# When true, emails are printed to the server console instead of being sent and
# the sign-in code is shown on screen. Development only — the API refuses to
# start with this set to true when NODE_ENV=production.
MAIL_PREVIEW_ONLY=true
